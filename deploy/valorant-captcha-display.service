[Unit]
Description=Valorant CAPTCHA virtual display
After=systemd-tmpfiles-setup.service
Before=valorant-bot.service

[Service]
Type=simple
User=valorant
Group=valorant
# tmpfiles keeps the outer Xauthority directory valorant-only and prepares a
# nested root-owned sticky directory that satisfies Xtrans. Only the nested
# socket directory is bind-mounted over this service's private /tmp path.
BindPaths=/run/valorant-captcha-display/X11-unix:/tmp/.X11-unix
ExecStartPre=/usr/local/libexec/valorant-bot/prepare-captcha-display-auth
ExecStart=/usr/bin/Xvfb :99 -screen 0 1280x900x24 -nolisten tcp -auth /run/valorant-captcha-display/Xauthority
ExecStopPost=/usr/bin/rm -f /run/valorant-captcha-display/Xauthority
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
