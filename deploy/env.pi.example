# Raspberry Pi (LAN) — systemd EnvironmentFile=/etc/valorant-bot/env
# Install: sudo ./deploy/install.sh --env deploy/env.pi.example
#
# Ports on the Pi (same idea as a normal Discord Gateway bot):
#   - /auth is a Riot Mobile QR login and needs no inbound port
#   - AUTH_PORT (8787) only serves /invite and the browser fallback page
#   - never open or bind privileged port 80 on the Pi

DISCORD_TOKEN=
DISCORD_APP_ID=

BOT_SECRET=change-me-to-a-32-char-secret!!

# Use the Pi's LAN IP (or mDNS hostname) so the /invite link is reachable
# Example: http://192.168.0.10:8787  or  http://raspberrypi.local:8787
AUTH_BASE_URL=http://192.168.0.10:8787
AUTH_PORT=8787

# Absolute path under WorkingDirectory=/var/lib/valorant-bot
DATABASE_PATH=/var/lib/valorant-bot/data/bot.db
STORE_RESET_CRON=0 0 * * *
