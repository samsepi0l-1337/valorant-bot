# Raspberry Pi — systemd EnvironmentFile=/etc/valorant-bot/env
# Install: sudo ./deploy/install.sh --env deploy/env.pi.example
#
# Base Pi install: QR only. `--remote-captcha` installs a separate,
# higher-priority remote-captcha.conf drop-in; do not set remote mode here.
# QR/disabled mode needs no public URL or inbound listener.

DISCORD_TOKEN=
DISCORD_APP_ID=

BOT_SECRET=change-me-to-a-32-char-secret!!

# Optional public URL for /invite. Remote CAPTCHA over the internet still needs a
# stable public HTTPS origin and a WebSocket-capable Tunnel/reverse proxy
# (`./scripts/setup-pi.sh --remote-captcha`). Same-LAN remote can use HTTP instead:
# AUTH_BASE_URL=http://<pi-lan-ip>:8787
# AUTH_BIND_ADDRESS=0.0.0.0
# and CAPTCHA_BROWSER_MODE=remote via the remote drop-in or a matching env override.
# See deploy/lan-remote-captcha.md. Do not use a public HTTP hostname.
AUTH_BASE_URL=http://127.0.0.1:8787
AUTH_PORT=8787

# Loopback is the secure default. Set 0.0.0.0 or the Pi LAN IP for LAN remote
# captcha without a tunnel; keep 127.0.0.1 when using Cloudflare Tunnel.
AUTH_BIND_ADDRESS=127.0.0.1

# Base Pi deployments are QR-only. The opt-in remote drop-in overrides this.
CAPTCHA_BROWSER_MODE=disabled
# The remote drop-in owns CAPTCHA_DISPLAY and XAUTHORITY; do not add either to
# this retained base environment.

DATABASE_PATH=/var/lib/valorant-bot/data/bot.db
STORE_RESET_CRON=0 0 * * *
