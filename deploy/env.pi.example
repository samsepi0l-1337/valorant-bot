# Raspberry Pi — systemd EnvironmentFile=/etc/valorant-bot/env
# Install: sudo ./deploy/install.sh --env deploy/env.pi.example
#
# Base Pi install: QR only. `--remote-captcha` installs a separate,
# higher-priority remote-captcha.conf drop-in; do not set remote mode here.
# QR/disabled mode needs no public URL or inbound listener.

DISCORD_TOKEN=
DISCORD_APP_ID=

BOT_SECRET=change-me-to-a-32-char-secret!!

# Optional public URL for /invite. Remote mode instead requires a stable public
# HTTPS origin and a WebSocket-capable Tunnel/reverse proxy.
AUTH_BASE_URL=http://127.0.0.1:8787
AUTH_PORT=8787

# Loopback is the secure default. Set a LAN address only for an intentional,
# firewall-restricted direct listener; remote CAPTCHA should use its HTTPS proxy.
AUTH_BIND_ADDRESS=127.0.0.1

# Base Pi deployments are QR-only. The opt-in remote drop-in overrides this.
CAPTCHA_BROWSER_MODE=disabled
# Used only in remote mode; unset values default to :99.
CAPTCHA_DISPLAY=:99

DATABASE_PATH=/var/lib/valorant-bot/data/bot.db
STORE_RESET_CRON=0 0 * * *
