# Raspberry Pi — systemd EnvironmentFile=/etc/valorant-bot/env
# Install: sudo ./deploy/install.sh --env deploy/env.pi.example
#
# Password login opens Chrome/Chromium on the Pi itself and needs a graphical
# desktop session. It does not need a public AUTH_BASE_URL or inbound port.
# Headless Pi installations should use Riot Mobile QR.
#
# AUTH_PORT serves /invite and optional local helper pages. Discord CAPTCHA
# re-open is a server-side button and does not require this URL to be public.
# Run ./scripts/pi-tunnel.sh only when you want /invite to be public.

DISCORD_TOKEN=
DISCORD_APP_ID=

BOT_SECRET=change-me-to-a-32-char-secret!!

# Optional public URL from ./scripts/pi-tunnel.sh, or the Pi LAN URL.
AUTH_BASE_URL=http://127.0.0.1:8787
AUTH_PORT=8787

DATABASE_PATH=/var/lib/valorant-bot/data/bot.db
STORE_RESET_CRON=0 0 * * *
