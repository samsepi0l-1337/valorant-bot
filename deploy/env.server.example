# Linux server / VPS — systemd or Docker
# systemd: sudo ./deploy/install.sh --env deploy/env.server.example
# Docker:  cp deploy/env.server.example .env.server && docker compose --env-file .env.server up -d

DISCORD_TOKEN=
DISCORD_APP_ID=

BOT_SECRET=change-me-to-a-32-char-secret!!

# /invite and optional helper pages. Neither /auth method needs an inbound port.
# On Linux, password login requires a desktop session with Chrome/Chromium on
# this host; Windows and headless servers should use Riot Mobile QR.
# Example: https://bot.example.com   or   http://YOUR_PUBLIC_IP:8787
AUTH_BASE_URL=https://bot.example.com
AUTH_PORT=8787

DATABASE_PATH=/var/lib/valorant-bot/data/bot.db
STORE_RESET_CRON=0 0 * * *
