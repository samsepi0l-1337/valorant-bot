# Linux server / VPS — systemd or Docker
# systemd: sudo ./deploy/install.sh --env deploy/env.server.example
# Docker:  cp deploy/env.server.example .env.server && docker compose --env-file .env.server up -d

DISCORD_TOKEN=
DISCORD_APP_ID=

BOT_SECRET=change-me-to-a-32-char-secret!!

# Public /invite URL. Remote CAPTCHA requires this exact, public HTTPS origin
# (no query/fragment/userinfo) and a reverse proxy/tunnel with WebSocket support.
# Example: https://bot.example.com
AUTH_BASE_URL=https://bot.example.com
AUTH_PORT=8787
# Keep the upstream private; override only for an intentional, firewall-restricted LAN listener.
AUTH_BIND_ADDRESS=127.0.0.1

# local: host GUI Chromium; remote: relay Pi/server Chromium to Discord user's
# browser; disabled: QR only. Headless servers without HTTPS/Xvfb use disabled.
CAPTCHA_BROWSER_MODE=disabled
# Used only in remote mode; default :99.
CAPTCHA_DISPLAY=:99

DATABASE_PATH=/var/lib/valorant-bot/data/bot.db
STORE_RESET_CRON=0 0 * * *
