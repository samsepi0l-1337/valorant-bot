# Local development (macOS / Linux laptop)
# Copy: cp deploy/env.local.example .env

DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=

BOT_SECRET=change-me-to-a-32-char-secret!!

# /invite and optional helper pages. Both /auth methods ignore this URL;
# password captcha opens Chrome locally on the bot machine.
AUTH_BASE_URL=http://127.0.0.1:8787
AUTH_PORT=8787

DATABASE_PATH=./data/bot.db
STORE_RESET_CRON=0 0 * * *
