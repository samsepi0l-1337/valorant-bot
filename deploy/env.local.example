# Local development (macOS / Linux laptop)
# Copy: cp deploy/env.local.example .env

DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=

BOT_SECRET=change-me-to-a-32-char-secret!!

# Public /invite URL. Leave this loopback URL for local mode; remote mode must
# instead use an absolute public HTTPS origin with reverse-proxy WebSocket support.
AUTH_BASE_URL=http://127.0.0.1:8787
AUTH_PORT=8787

# local is the default: GUI Chrome/Chromium runs on this bot host.
# remote needs HTTPS + Xvfb/Chromium on the host; disabled offers QR only.
CAPTCHA_BROWSER_MODE=local
CAPTCHA_DISPLAY=

DATABASE_PATH=./data/bot.db
STORE_RESET_CRON=0 0 * * *
