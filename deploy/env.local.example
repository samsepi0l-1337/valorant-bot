# Local development (macOS / Linux laptop)
# Copy: cp deploy/env.local.example .env

DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=

BOT_SECRET=change-me-to-a-32-char-secret!!

# Public /invite URL. Leave this loopback URL for local mode.
AUTH_BASE_URL=http://127.0.0.1:8787
AUTH_PORT=8787
# Loopback is the default. Override only for an intentional, firewall-restricted LAN listener.
AUTH_BIND_ADDRESS=127.0.0.1

# local is the default: GUI Chrome/Chromium runs on this bot host.
# remote needs Xvfb/Chromium on the host (Pi) or a desktop session (laptop);
# disabled offers QR only.
CAPTCHA_BROWSER_MODE=local
# Used only in remote mode; default :99.
CAPTCHA_DISPLAY=:99

# LAN remote CAPTCHA without Cloudflare Tunnel (another computer on the same
# Wi-Fi/LAN opens the Discord link). Uncomment and replace <lan-ip>:
# AUTH_BASE_URL=http://<lan-ip>:8787
# AUTH_BIND_ADDRESS=0.0.0.0
# CAPTCHA_BROWSER_MODE=remote
# Off-LAN / LTE: keep AUTH_BIND_ADDRESS=127.0.0.1. Quick tunnel (test-only):
# ./scripts/run-local-remote.sh writes AUTH_BASE_URL to this file.
# Persistent named tunnel (https://programtyping.dreamp.org):
# ./scripts/named-tunnel.sh then optionally --write-env.
# See deploy/pi-cloudflare-tunnel.md. Do not mint Riot captcha on the tunnel hostname.

DATABASE_PATH=./data/bot.db
STORE_RESET_CRON="0 0 * * *"
