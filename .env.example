# Discord
DISCORD_TOKEN=
DISCORD_APP_ID=
# Optional: register slash commands to one guild (faster during dev)
DISCORD_GUILD_ID=

# 32+ characters — encrypts Riot session cookies at rest
BOT_SECRET=

# URL users open in a browser (use Pi LAN IP on Raspberry Pi)
# Example: http://192.168.0.10:8787
AUTH_BASE_URL=

# Auth HTTP listen port (default 8787)
AUTH_PORT=8787

# SQLite database path (default ./data/bot.db)
DATABASE_PATH=./data/bot.db

# Cron for daily store reset posts (used when scheduler is wired)
STORE_RESET_CRON=0 0 * * *
