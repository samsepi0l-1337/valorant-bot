# Discord
DISCORD_TOKEN=
DISCORD_APP_ID=
# Optional: register slash commands to one guild (faster during dev)
DISCORD_GUILD_ID=

# 32+ characters — encrypts Riot session cookies at rest
BOT_SECRET=

# Public URL for /invite and, only in remote CAPTCHA mode, the viewer.
# remote requires an absolute HTTPS URL (no query, fragment, or user info),
# such as https://bot.example.com. local/disabled follow their usual deployment
# URL setting; only remote requires this exact public HTTPS origin.
AUTH_BASE_URL=

# Auth HTTP listen port (default 8787)
AUTH_PORT=8787

# Loopback is the secure default. Override only for an intentional,
# firewall-restricted LAN listener; remote CAPTCHA uses its HTTPS proxy/tunnel.
AUTH_BIND_ADDRESS=127.0.0.1

# CAPTCHA browser mode: local (default), remote, or disabled.
# local: GUI Chrome/Chromium on this bot host.
# remote: GUI Chromium on this host is relayed to the Discord user's browser;
#         needs HTTPS AUTH_BASE_URL, a reverse proxy with WebSocket support,
#         and Xvfb/Chromium on the bot host. The user installs nothing.
# disabled: password CAPTCHA is rejected with a Riot Mobile QR recommendation.
CAPTCHA_BROWSER_MODE=local

# Display used only by remote mode (default :99).
CAPTCHA_DISPLAY=:99

# SQLite database path (default ./data/bot.db)
DATABASE_PATH=./data/bot.db

# Cron for daily store reset posts (used when scheduler is wired)
STORE_RESET_CRON=0 0 * * *
