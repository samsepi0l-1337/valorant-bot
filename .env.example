# Discord
DISCORD_TOKEN=
DISCORD_APP_ID=
# Optional: register slash commands to one guild (faster during dev)
DISCORD_GUILD_ID=

# 32+ characters — encrypts Riot session cookies at rest
BOT_SECRET=

# URL for /invite and other optional public AUTH_PORT pages.
# Password captcha itself opens Chrome on the bot machine (authenticate.riotgames.com host-map),
# so a public tunnel is NOT required for the checkbox or Discord re-open button.
# Mac/Pi invite: run cloudflared if you want a public /invite URL:
#   brew install cloudflared
#   ./scripts/pi-tunnel.sh
AUTH_BASE_URL=

# Auth HTTP listen port (default 8787)
AUTH_PORT=8787

# SQLite database path (default ./data/bot.db)
DATABASE_PATH=./data/bot.db

# Cron for daily store reset posts (used when scheduler is wired)
STORE_RESET_CRON=0 0 * * *
